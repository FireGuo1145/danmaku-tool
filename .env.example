# ===== 页面 / 房间 =====
# 页面标题
VITE_APP_TITLE=弹幕台
# 默认房间号（真实房间号或短号都行）
VITE_DEFAULT_ROOM_ID=5440
# 打开页面后自动连接
VITE_AUTO_CONNECT=true
# 首页空状态里的快捷房间（逗号分隔）
VITE_QUICK_ROOMS=7734200,21144080,3947892,5050

# ===== 弹幕协议 =====
# 1 = 明文；2 = zlib（推荐）。浏览器端暂不支持 3（Brotli）
VITE_PROTOVER=2
# 消息列表最多保留条数
VITE_MAX_MESSAGES=200

# ===== 显示偏好 =====
VITE_SHOW_ENTER=true
VITE_SHOW_LIKE=false
# 金瓜子价值达到该数值时，右下角弹出礼物提示（1000 金瓜子 = 1 元）
VITE_GIFT_TOAST_MIN=1000
# 访客弹幕凭证自动刷新间隔（分钟）：B 站一段时间后会把访客昵称打码，重连可恢复；0 关闭定期刷新（仍保留打码自救）
VITE_AUTH_REFRESH_MINUTES=10
# 默认进入演示模式（本地回放，不连 B 站）
VITE_DEMO_MODE=false

# ===== 接口代理 =====
# 本地 Vite 中间件的代理前缀，一般不用改
VITE_BILI_API_BASE=/bili-api

# ===== 可选：登录态（一般留空即可，留空时以访客身份连接） =====
# 想显示更完整的身份信息时，可以填入自己账号的 uid / buvid / 弹幕 token
VITE_BILI_UID=
VITE_BILI_BUVID=
VITE_BILI_TOKEN=

# ===== 可选：登录态（服务端专用，不加 VITE_ 前缀，不会打包进浏览器） =====
# 填入 B 站 Cookie（整段，或只填 SESSDATA 的值），可减少弹幕昵称被 *** 打码
# 例：BILI_COOKIE=SESSDATA=xxxx; bili_jct=xxxx; DedeUserID=123456
BILI_COOKIE=
# Cookie 里没有 DedeUserID 时，可手动指定 uid
BILI_UID=
